{
  "name": "pi-ocarina",
  "version": "0.1.0",
  "description": "Keyboard-first desktop GUI for the pi coding agent",
  "main": "./dist/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "dev:web": "vite --config vite.web.config.ts",
    "build": "electron-vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "rebuild:native": "electron-rebuild -f -w node-pty"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tsconfig/svelte": "^5.0.4",
    "electron": "^38.2.2",
    "electron-vite": "^4.0.1",
    "svelte": "^5.42.2",
    "svelte-check": "^4.3.3",
    "typebox": "1.3.7",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.84.2",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "node-pty": "^1.1.0",
    "vscode-jsonrpc": "9.0.1"
  }
}
